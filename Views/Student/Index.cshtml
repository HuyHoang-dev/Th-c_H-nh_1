@model IEnumerable<Student>

<h2>lab_1</h2>

<a asp-controller="Student" asp-action="Create" class="btn btn-primary mb-3">Create Student</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ảnh đại diện</th>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>
                    <img src="@s.AvatarUrl" alt="Avatar" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;" />
                </td>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBorth.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case Branch.IT:
                                str = "CNTT";
                                break;
                            case Branch.BE:
                                str = "Kinh tế";
                                break;
                            case Branch.CE:
                                str = "Công trình";
                                break;
                            case Branch.EE:
                                str = "Điện - Điện tử";
                                break;
                        }
                    }
                    @str
                </td>
                <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>